<!-- File: views/admin/users.ejs -->
<% title = 'Users' %>

<div class="container py-4">
  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h1 class="h3">Users</h1>

      <a href="/admin/users/new" class="btn btn-success">
        Add User
      </a>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead class="table-light">
        <tr>
          <th scope="col">Username</th>
          <th scope="col">Email</th>
          <th scope="col">Role</th>
          <th scope="col">Membership</th>
          <th scope="col">Discount</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.username %></td>

            <td><%= user.email %></td>

            <td>
              <%= user.RoleId === 1 ? 'Admin' : 'User' %>
            </td>

            <td>
              <%= user.Membership ? user.Membership.name : '—' %>
            </td>

            <td>
              <%= user.Membership ? user.Membership.discount : 0 %>%
            </td>

            <td>
              <div class="action-buttons">

                <% if (user.RoleId === 1) { %>

                  <form
                    action="/admin/users/<%= user.id %>/demote"
                    method="POST"
                  >
                    <button
                      type="submit"
                      class="btn btn-action-secondary"
                    >
                      Make User
                    </button>
                  </form>

                <% } else { %>

                  <form
                    action="/admin/users/<%= user.id %>/promote"
                    method="POST"
                  >
                    <button
                      type="submit"
                      class="btn btn-action-primary"
                    >
                      Make Admin
                    </button>
                  </form>

                <% } %>

              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>





